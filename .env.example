# GreenGuard 2.0 Backend Environment Configuration

PORT=5000
NODE_ENV=development
JWT_SECRET=greenguard_super_secret_jwt_key_2026

# Database Configuration (PostgreSQL with automatic SQLite fallback)
# Set to 'postgres' to use PostgreSQL, or 'sqlite' for zero-config embedded DB
DB_DIALECT=sqlite
DB_STORAGE=./data/greenguard.sqlite

# PostgreSQL Configuration (used if DB_DIALECT=postgres or auto-detected)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=green-guard
DB_USER=postgres
DB_PASSWORD=postgres

# Email / SMTP Configuration for OTP Verification & Complaints
EMAIL_USER=greenguard.satellite@gmail.com
EMAIL_PASS=your_app_password_here
TARGET_COMPLAINT_EMAIL=waniahmaryam@gmail.com

# External News API Keys (Optional - historical fallback provided automatically)
NEWS_KEY=
GNEWS_KEY=

# Python Executable Path (Optional - defaults to 'python')
PYTHON_PATH=python
